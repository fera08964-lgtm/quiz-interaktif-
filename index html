<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz Interaktif MTs DDI Kelurahan Baru</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f0f4f8;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 700px;
            padding: 30px;
        }

        header {
            text-align: center;
            margin-bottom: 25px;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 15px;
        }

        h1 {
            color: #1e3a8a;
            font-size: 22px;
            margin-bottom: 5px;
        }

        h2 {
            color: #3b82f6;
            font-size: 16px;
            font-weight: 500;
        }

        .btn {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
            display: inline-block;
        }

        .btn:hover {
            background-color: #1d4ed8;
        }

        .btn-secondary {
            background-color: #64748b;
        }

        .btn-secondary:hover {
            background-color: #475569;
        }

        .btn-danger {
            background-color: #ef4444;
        }

        .btn-danger:hover {
            background-color: #dc2626;
        }

        .btn-success {
            background-color: #10b981;
        }

        .btn-success:hover {
            background-color: #059669;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            font-size: 14px;
        }

        input[type="text"], input[type="password"], select {
            width: 100%;
            padding: 10px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 14px;
        }

        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        .welcome-card {
            text-align: center;
            padding: 20px 0;
        }

        .welcome-card p {
            margin-bottom: 20px;
            color: #64748b;
            line-height: 1.6;
        }

        .role-selection {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        .quiz-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            font-weight: bold;
            color: #64748b;
        }

        .question-text {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #1e293b;
        }

        .options-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 25px;
        }

        .option-item {
            background-color: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            padding: 12px 16px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .option-item:hover {
            background-color: #eff6ff;
            border-color: #93c5fd;
        }

        .option-item.selected {
            background-color: #dbeafe;
            border-color: #2563eb;
            font-weight: 600;
        }

        .result-box {
            text-align: center;
            padding: 20px 0;
        }

        .score-display {
            font-size: 48px;
            font-weight: bold;
            color: #2563eb;
            margin: 15px 0;
        }

        .admin-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 10px;
        }

        .tab-btn {
            background: none;
            border: none;
            padding: 8px 16px;
            cursor: pointer;
            font-weight: 600;
            color: #64748b;
            border-radius: 4px;
        }

        .tab-btn.active {
            background-color: #e0e7ff;
            color: #4338ca;
        }

        .question-item {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            background-color: #f8fafc;
        }

        .question-item-actions {
            margin-top: 10px;
            display: flex;
            gap: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            border: 1px solid #e2e8f0;
            padding: 10px;
            text-align: left;
            font-size: 14px;
        }

        th {
            background-color: #f1f5f9;
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>Selamat Datang di Quiz Interaktif</h1>
            <h2>MTs DDI Kelurahan Baru</h2>
        </header>

        <!-- HALAMAN UTAMA -->
        <div id="page-home" class="page active">
            <div class="welcome-card">
                <p>Silakan pilih peran Anda untuk melanjutkan ke dalam sistem quiz.</p>
                <div class="role-selection">
                    <button class="btn" onclick="showPage('page-participant-login')">Masuk Peserta</button>
                    <button class="btn btn-secondary" onclick="showPage('page-admin-login')">Login Admin</button>
                </div>
            </div>
        </div>

        <!-- LOGIN PESERTA -->
        <div id="page-participant-login" class="page">
            <h3 style="margin-bottom: 15px;">Data Peserta</h3>
            <div class="form-group">
                <label>Nama Lengkap</label>
                <input type="text" id="participant-name" placeholder="Masukkan nama Anda">
            </div>
            <div class="form-group">
                <label>Kelas</label>
                <input type="text" id="participant-class" placeholder="Contoh: VII A">
            </div>
            <button class="btn" onclick="startQuiz()">Mulai Kerjakan Quiz</button>
            <button class="btn btn-secondary" onclick="showPage('page-home')">Kembali</button>
        </div>

        <!-- LOGIN ADMIN -->
        <div id="page-admin-login" class="page">
            <h3 style="margin-bottom: 15px;">Login Admin</h3>
            <div class="form-group">
                <label>Username</label>
                <input type="text" id="admin-user" placeholder="Username (default: admin)">
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" id="admin-pass" placeholder="Password (default: admin123)">
            </div>
            <button class="btn" onclick="loginAdmin()">Login</button>
            <button class="btn btn-secondary" onclick="showPage('page-home')">Kembali</button>
        </div>

        <!-- HALAMAN QUIZ PESERTA -->
        <div id="page-quiz" class="page">
            <div class="quiz-header">
                <span id="quiz-progress">Soal 1 dari 5</span>
                <span id="quiz-student-info"></span>
            </div>
            <div class="question-text" id="quiz-question"></div>
            <div class="options-list" id="quiz-options"></div>
            <button class="btn" id="btn-next" onclick="nextQuestion()">Soal Berikutnya</button>
        </div>

        <!-- HALAMAN HASIL QUIZ -->
        <div id="page-result" class="page">
            <div class="result-box">
                <h3>Quiz Selesai!</h3>
                <p>Terima kasih telah menyelesaikan ujian.</p>
                <div class="score-display" id="result-score">0</div>
                <p id="result-detail"></p>
                <br>
                <button class="btn" onclick="showPage('page-home')">Kembali ke Halaman Utama</button>
            </div>
        </div>

        <!-- DASHBOARD ADMIN -->
        <div id="page-admin-dashboard" class="page">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h3>Panel Admin</h3>
                <button class="btn btn-danger" onclick="showPage('page-home')">Logout</button>
            </div>

            <div class="admin-nav">
                <button class="tab-btn active" onclick="switchAdminTab('tab-soal')">Kelola Soal</button>
                <button class="tab-btn" onclick="switchAdminTab('tab-nilai')">Rekap Nilai</button>
            </div>

            <!-- TAB KELOLA SOAL -->
            <div id="tab-soal" class="admin-tab">
                <button class="btn btn-success" style="margin-bottom: 15px;" onclick="openQuestionForm()">+ Tambah Soal Baru</button>
                <div id="question-list"></div>
            </div>

            <!-- TAB REKAP NILAI -->
            <div id="tab-nilai" class="admin-tab" style="display: none;">
                <h4>Daftar Nilai Peserta</h4>
                <table>
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Nama</th>
                            <th>Kelas</th>
                            <th>Benar</th>
                            <th>Nilai</th>
                            <th>Waktu</th>
                        </tr>
                    </thead>
                    <tbody id="score-table-body"></tbody>
                </table>
            </div>
        </div>

        <!-- FORM SOAL (TAMBAH / EDIT) -->
        <div id="page-question-form" class="page">
            <h3 id="form-title" style="margin-bottom: 15px;">Tambah Soal Baru</h3>
            <input type="hidden" id="form-question-id">
            <div class="form-group">
                <label>Pertanyaan</label>
                <input type="text" id="form-question-text" placeholder="Tuliskan soal...">
            </div>
            <div class="form-group">
                <label>Pilihan A</label>
                <input type="text" id="form-opt-0" placeholder="Jawaban A">
            </div>
            <div class="form-group">
                <label>Pilihan B</label>
                <input type="text" id="form-opt-1" placeholder="Jawaban B">
            </div>
            <div class="form-group">
                <label>Pilihan C</label>
                <input type="text" id="form-opt-2" placeholder="Jawaban C">
            </div>
            <div class="form-group">
                <label>Pilihan D</label>
                <input type="text" id="form-opt-3" placeholder="Jawaban D">
            </div>
            <div class="form-group">
                <label>Kunci Jawaban Benar</label>
                <select id="form-correct-answer">
                    <option value="0">Pilihan A</option>
                    <option value="1">Pilihan B</option>
                    <option value="2">Pilihan C</option>
                    <option value="3">Pilihan D</option>
                </select>
            </div>
            <button class="btn btn-success" onclick="saveQuestion()">Simpan Soal</button>
            <button class="btn btn-secondary" onclick="showPage('page-admin-dashboard')">Batal</button>
        </div>

    </div>

    <script>
        // DATA DEFAULT (5 SOAL AWAL)
        const defaultQuestions = [
            {
                id: 1,
                question: "Apa ibu kota negara Indonesia saat ini?",
                options: ["Bandung", "Jakarta", "Surabaya", "Medan"],
                correct: 1
            },
            {
                id: 2,
                question: "Planet manakah yang dikenal sebagai Planet Merah?",
                options: ["Venus", "Jupiter", "Mars", "Saturnus"],
                correct: 2
            },
            {
                id: 3,
                question: "Berapakah hasil dari 8 x 7?",
                options: ["54", "56", "64", "48"],
                correct: 1
            },
            {
                id: 4,
                question: "Siapakah pencipta lagu 'Indonesia Raya'?",
                options: ["W.R. Soepratman", "K.H. Dewantara", "Soekarno", "Moh. Hatta"],
                correct: 0
            },
            {
                id: 5,
                question: "Bahasa pemrograman yang populer untuk membuat halaman web interaktif adalah?",
                options: ["Python", "C++", "Java", "JavaScript"],
                correct: 3
            }
        ];

        // STATE APLIKASI
        let questions = JSON.parse(localStorage.getItem('quiz_questions')) || defaultQuestions;
        let results = JSON.parse(localStorage.getItem('quiz_results')) || [];
        
        let currentParticipant = { name: '', class: '' };
        let currentQuestionIndex = 0;
        let selectedAnswers = []; 
        let currentShuffledOptions = [];

        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.getElementById(pageId).classList.add('active');
        }

        // AKSI PESERTA
        function startQuiz() {
            const name = document.getElementById('participant-name').value.trim();
            const pClass = document.getElementById('participant-class').value.trim();

            if (!name || !pClass) {
                alert('Silakan isi Nama dan Kelas terlebih dahulu!');
                return;
            }

            if (questions.length === 0) {
                alert('Belum ada soal yang tersedia!');
                return;
            }

            currentParticipant = { name, class: pClass };
            currentQuestionIndex = 0;
            selectedAnswers = new Array(questions.length).fill(null);

            document.getElementById('quiz
